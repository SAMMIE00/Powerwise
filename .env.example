# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=generate-a-secure-random-secret-key-for-production

# Database Configuration
# Local development (SQLite):
DATABASE_URL=sqlite:///powerwise.db
# Production (Neon / PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/powerwise?sslmode=require

# Cookie Security (set to True in production HTTPS environments)
SESSION_COOKIE_SECURE=False
